{
  "name": "shadowlab-replay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "demo": "node packages/cli/main.ts demo",
    "test": "node --test tests/*.test.ts",
    "coverage": "node --experimental-test-coverage --test-coverage-include=packages/core/*.ts --test-coverage-lines=85 --test tests/*.test.ts",
    "record": "node packages/cli/main.ts record",
    "replay": "node packages/cli/main.ts replay",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build-history.ts",
    "snapshot": "node tools/snapshot.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "bin": {
    "shadowlab": "packages/cli/bin.js"
  }
}
