{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShadowLab workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "fixture", "clock", "steps", "comparison"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fixture": {
      "const": "carts-basic-v1"
    },
    "clock": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "request"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path"],
            "properties": {
              "method": {
                "enum": ["GET", "POST", "PATCH"]
              },
              "path": {
                "type": "string",
                "pattern": "^/test/carts(?:/|$)"
              },
              "json": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sku": {
                    "const": "SHOE-001"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  "code": {
                    "const": "SAVE10"
                  }
                }
              }
            }
          },
          "capture": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,39}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "path"],
              "properties": {
                "from": {
                  "const": "response.body"
                },
                "path": {
                  "enum": ["$.id", "$.entity.id"]
                }
              }
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "equals"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\$\\.[A-Za-z][A-Za-z0-9.]*$"
                },
                "equals": {
                  "type": ["number", "string", "null", "boolean"]
                }
              }
            }
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "poll": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "equals", "interval_ms", "max_attempts"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\$\\.[A-Za-z][A-Za-z0-9.]*$"
              },
              "equals": {
                "type": ["number", "string", "null", "boolean"]
              },
              "interval_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore_paths": {
          "type": "array",
          "items": {
            "const": "$.generatedAt"
          }
        },
        "compare_numeric_exactly": {
          "type": "array",
          "items": {
            "enum": ["$.subtotal", "$.discount", "$.total"]
          }
        },
        "ordered_sets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$.items": {
              "const": "id"
            }
          }
        }
      }
    }
  }
}
