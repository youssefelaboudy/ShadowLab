{
  "name": "coupon-quantity",
  "version": 1,
  "fixture": "carts-basic-v1",
  "clock": "2026-01-15T10:00:00.000Z",
  "steps": [
    {
      "name": "create_cart",
      "method": "POST",
      "path": "/test/carts",
      "capture": "cart_id"
    },
    {
      "name": "add_item",
      "method": "POST",
      "path": "/test/carts/${cart_id}/items",
      "json": {
        "sku": "SHOE-001",
        "quantity": 1
      },
      "capture": "item_id"
    },
    {
      "name": "apply_coupon",
      "method": "POST",
      "path": "/test/carts/${cart_id}/coupons",
      "json": {
        "code": "SAVE10"
      }
    },
    {
      "name": "change_quantity",
      "method": "PATCH",
      "path": "/test/carts/${cart_id}/items/${item_id}",
      "json": {
        "quantity": 2
      }
    },
    {
      "name": "summary",
      "method": "GET",
      "path": "/test/carts/${cart_id}/summary",
      "assert": {
        "currency": "CAD"
      }
    }
  ],
  "ignore": [
    "$.generatedAt"
  ]
}
